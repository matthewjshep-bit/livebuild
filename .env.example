# ---------------------------------------------------------------------------
# All of this is optional. With none of it set, Livebuild.ai runs exactly as it
# always has: a local-first tour builder that stores everything in the browser.
# Each block switches on one additional capability.
# ---------------------------------------------------------------------------

# AI pass on the "describe your house" step.
# Without it the wizard falls back to its offline parser, which handles most
# descriptions on its own.
ANTHROPIC_API_KEY=

# Publishing — Supabase project. See supabase/README.md for the ten-minute setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security entirely, so it must never appear in
# client code or in any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Publish gate for a single operator. Anyone can view a published tour; only
# someone with this passphrase can create one. Generate something long:
#   openssl rand -base64 32
MATTERMATT_ADMIN_KEY=

# Listing import (Zillow via Apify). Without it the "pull it from a listing"
# box is hidden and photos are added by hand.
APIFY_TOKEN=

# Reading a shared Google Drive folder of photos. Optional: without it the
# "paste a Drive folder link" box is hidden and photos are dropped in by hand.
#
# The Maps key below works too if it is not restricted to the Maps APIs - Drive
# is a separate API on the same project, and a restricted key returns 403 in a
# way that looks nothing like a permissions problem.
GOOGLE_DRIVE_API_KEY=

# Satellite and Street View, from your own Google Maps Platform key. Used to
# read the outside of the house - storeys, roof, materials, which side the front
# door is on - to fill in what OpenStreetMap has not tagged.
#
# The building's outline is never traced from imagery; that still comes from the
# map. Pictures are fetched on the server, read, and never stored.
GOOGLE_MAPS_API_KEY=

